//Build script for use with kalamake. Read more at https://github.com/kalakit/kalamake

#version 1.0

#references
name_bin: kalagraphics
dir_release: build/temp/release-
dir_debug: build/temp/debug-
def_win: WIN32_LEAN_AND_MEAN, NOMINMAX, UNICODE, _UNICODE

#global
compilerlauncher: ccache
compiler: clang++
standard: c++20
binarytype: static
sources: "src"
headers: "include", "external/kalaheaders/include"
defines: LIB_STATIC
warninglevel: normal
customflags: export-compile-commands, export-vscode-sln

#profile debug-windows
binaryname: ${name_bin}d
buildtype: debug
buildpath: "${dir_debug}windows"
defines: ${def_win}
headers: "external/vulkan/Include", "external/spirv-reflect/debug-windows/include", "external/harfbuzz/debug-windows/include", "external/cgltf/debug-windows/include", "external/lodepng/debug-windows/include"

#profile release-windows
binaryname: ${name_bin}
buildtype: minsizerel
buildpath: "${dir_release}windows"
defines: ${def_win}
headers: "external/vulkan/Include", "external/spirv-reflect/release-windows/include", "external/harfbuzz/release-windows/include", "external/cgltf/release-windows/include", "external/lodepng/release-windows/include"

#profile debug-windows-gnu
targettype: windows-gnu
binaryname: ${name_bin}-gnud
buildtype: debug
buildpath: "${dir_debug}windows-gnu"
defines: ${def_win}
headers: "external/vulkan/Include", "external/spirv-reflect/debug-windows-gnu/include", "external/harfbuzz/debug-windows-gnu/include", "external/cgltf/debug-windows-gnu/include", "external/lodepng/debug-windows-gnu/include"

#profile release-windows-gnu
targettype: windows-gnu
binaryname: ${name_bin}-gnu
buildtype: minsizerel
buildpath: "${dir_release}windows-gnu"
defines: ${def_win}
headers: "external/vulkan/Include", "external/spirv-reflect/release-windows-gnu/include", "external/harfbuzz/release-windows-gnu/include", "external/cgltf/release-windows-gnu/include", "external/lodepng/release-windows-gnu/include"

#profile debug-linux
binaryname: lib${name_bin}d
buildtype: debug
buildpath: "${dir_debug}linux"
headers: "external/vulkan/Include", "external/spirv-reflect/debug-linux/include", "external/harfbuzz/debug-linux/include", "external/cgltf/debug-linux/include", "external/lodepng/debug-linux/include"

#profile release-linux
binaryname: lib${name_bin}
buildtype: minsizerel
buildpath: "${dir_release}linux"
headers: "external/vulkan/Include", "external/spirv-reflect/release-linux/include", "external/harfbuzz/release-linux/include", "external/cgltf/release-linux/include", "external/lodepng/release-linux/include"
