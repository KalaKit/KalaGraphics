#KMF VERSION 1.0

//Manifest file for use with KalaMove. Read more at https://github.com/kalakit/kalamove

//
// CORE STUFF
//

//copy readme
origin: README.md
target: ..@external-shared@KalaGraphics@README.md
action: forcecopy

//copy license
origin: LICENSE.md
target: ..@external-shared@KalaGraphics@LICENSE.md
action: forcecopy

//copy include files
origin: include
target: ..@external-shared@KalaGraphics@include
action: forcecopy

//copy docs
origin: docs
target: ..@external-shared@KalaGraphics@docs
action: forcecopy

//copy files
origin: files
target: ..@external-shared@KalaGraphics@files
action: forcecopy

//
// BINARIES
//

//copy debug
origin: build@debug-windows@kalagraphicsd.lib
target: ..@external-shared@KalaGraphics@debug@kalagraphicsd.lib
action: forcecopy

//copy release
origin: build@release-windows@kalagraphics.lib
target: ..@external-shared@KalaGraphics@release@kalagraphics.lib
action: forcecopy
