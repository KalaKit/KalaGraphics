#KMF VERSION 1.0

//Manifest file for use with KalaMove. Read more at https://github.com/kalakit/kalamove

//
// CORE STUFF
//

//copy readme
origin: README.md
target: ..@external-shared@KalaGraphics@README.md
action: forcecopy

//copy license
origin: LICENSE.md
target: ..@external-shared@KalaGraphics@LICENSE.md
action: forcecopy

//copy include files
origin: include
target: ..@external-shared@KalaGraphics@include
action: forcecopy

//copy docs
origin: docs
target: ..@external-shared@KalaGraphics@docs
action: forcecopy

//
// BINARIES
//

//copy debug
origin: build@debug-linux@libkalagraphicsd.a
target: ..@external-shared@KalaGraphics@debug@libkalagraphicsd.a
action: forcecopy

//copy release
origin: build@release-linux@libkalagraphics.a
target: ..@external-shared@KalaGraphics@release@libkalagraphics.a
action: forcecopy
